Algoritmo Promedio
	Escribir "Hola Mundo"
	Escribir "Ingrese su primera nota"
	Leer Nota1
	Escribir Nota1
	Escribir "Ingrese su segunda nota"
	Leer Nota2
	Escribir Nota2
	Escribir "Ingrese su tercera nota"
	Leer Nota3
	Escribir Nota3
	prom <- (Nota1 + Nota2 + Nota3) /3
	Escribir "Este es el promedio de las 3 notas: ", prom
	//Ahora dicidimos si aprobó o reprobó
	Si prom >= 65 Entonces
		Escribir "Aprobaste"
	SiNo
		Escribir "Reprobaste"
	Fin Si
FinAlgoritmo
