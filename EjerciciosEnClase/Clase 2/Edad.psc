Algoritmo edad
	Escribir "Ingrese año de nacimiento"
	Leer nacimiento
	Escribir "Ingrese el año actual"
	Leer actual
	tuedad <- actual - nacimiento
	Escribir "Esta es tu edad :"
	Si tuedad >=18 Entonces
		Escribir "Tienes ", tuedad, " años y eres mayor de edad"
	SiNo
		Escribir "Tienes ", tuedad, " años y eres menor de edad"
	Fin Si
FinAlgoritmo
