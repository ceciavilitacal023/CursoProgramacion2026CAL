Algoritmo NumeroEntre
		Definir numero Como Entero
		Definir estado Como Logico
		Escribir "Ingresa un numero"
		Leer numero
		estado <- numero >= 1 Y numero <= 100
		Escribir estado
		Si estado Entonces
			Escribir "El numero esta entre 1 y 100"
		SiNo
			Escribir "El numero no esta entre 1 y 100"
		FinSi
FinAlgoritmo
